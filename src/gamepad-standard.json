{
  "version": 1,
  "name": "Standard",
  "settings": { "deadZone": 0.5, "triggerThreshold": 0.5 },
  "bindings": {
    "zoom-in": { "input": "D-Up", "modifiers": [] },
    "zoom-out": { "input": "D-Down", "modifiers": [] },
    "quick-solve": { "input": "Menu", "modifiers": [] },
    "next-step": { "input": "A", "modifiers": [] },
    "undo": { "input": "B", "modifiers": [] },
    "scramble": { "input": "X", "modifiers": ["View"] },
    "reset": { "input": "Y", "modifiers": ["View"] },
    "cube-up": { "input": "RS-Up", "modifiers": [] },
    "cube-down": { "input": "RS-Down", "modifiers": [] },
    "cube-left": { "input": "RS-Left", "modifiers": [] },
    "cube-right": { "input": "RS-Right", "modifiers": [] },
    "left-cw": { "input": "LS-Down", "modifiers": [] },
    "left-ccw": { "input": "LS-Up", "modifiers": [] },
    "right-cw": { "input": "LS-Up", "modifiers": ["RT"] },
    "right-ccw": { "input": "LS-Down", "modifiers": ["RT"] },
    "front-cw": { "input": "LS-Right", "modifiers": [] },
    "front-ccw": { "input": "LS-Left", "modifiers": [] },
    "back-cw": { "input": "LS-Right", "modifiers": ["RT"] },
    "back-ccw": { "input": "LS-Left", "modifiers": ["RT"] },
    "top-cw": { "input": "LB", "modifiers": [] },
    "top-ccw": { "input": "LB", "modifiers": ["LT"] },
    "bottom-cw": { "input": "RB", "modifiers": [] },
    "bottom-ccw": { "input": "RB", "modifiers": ["LT"] },
    "front-double": { "input": "LS-Right", "modifiers": ["LT"] },
    "back-double": { "input": "LS-Right", "modifiers": ["LT", "RT"] },
    "left-double": { "input": "LS-Up", "modifiers": ["LT"] },
    "right-double": { "input": "LS-Up", "modifiers": ["LT", "RT"] },
    "top-double": { "input": "Y", "modifiers": [] },
    "bottom-double": { "input": "X", "modifiers": [] }
  }
}
